rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.size() == 10 && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.fullName is string &&
             data.fullName.size() >= 2 &&
             data.fullName.size() <= 80 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             data.photoBase64 is string &&
             data.photoBase64.size() >= 100 &&
             data.photoBase64.size() <= 400000;
    }

    function isValidAttendanceRecord(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userName is string &&
             data.userName.size() >= 2 &&
             data.userName.size() <= 80 &&
             isValidDateKey(data.dateKey) &&
             data.inTime is timestamp &&
             data.inConfidence is int &&
             data.inConfidence >= 65 &&
             data.inConfidence <= 100 &&
             data.faceVerificationStatus == 'VERIFIED' &&
             data.attendanceStatus in ['CHECKED_IN', 'COMPLETED'] &&
             data.starred is bool &&
             (!('outConfidence' in data) || (data.outConfidence is int && data.outConfidence >= 65 && data.outConfidence <= 100));
    }

    function isValidVerificationLog(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userName is string &&
             data.userName.size() >= 1 &&
             data.userName.size() <= 80 &&
             isValidDateKey(data.dateKey) &&
             data.actionType in ['IN', 'OUT'] &&
             data.faceVerificationStatus in ['VERIFIED', 'FAILED', 'SKIPPED'] &&
             data.attendanceStatus in ['SUCCESS', 'FAILED'] &&
             data.reason is string &&
             data.reason.size() >= 1 &&
             data.reason.size() <= 240 &&
             data.confidence is int &&
             data.confidence >= 0 &&
             data.confidence <= 100;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll(['userId', 'fullName', 'photoBase64', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'fullName', 'email', 'photoBase64', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming()) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time;

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'email', 'photoBase64', 'updatedAt']);

      allow delete: if false;

      match /attendance/{dateKey} {
        allow get: if isSignedIn() && isValidId(userId) && isValidDateKey(dateKey) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        // Check-IN only once per day (document ID is dateKey). outTime cannot be set on create.
        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidDateKey(dateKey) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll([
                           'userId', 'userName', 'dateKey', 'inTime', 'inConfidence',
                           'faceVerificationStatus', 'attendanceStatus', 'starred', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'userName', 'dateKey', 'inTime', 'inConfidence',
                           'faceVerificationStatus', 'attendanceStatus', 'starred', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidAttendanceRecord(incoming()) &&
                         incoming().dateKey == dateKey &&
                         incoming().attendanceStatus == 'CHECKED_IN' &&
                         incoming().inTime <= request.time &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time;

        // Update is strictly partitioned: either Check-OUT once (with immutable inTime) or Toggle Star.
        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidDateKey(dateKey) &&
                         request.auth.uid == userId &&
                         isValidAttendanceRecord(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().userName == existing().userName &&
                         incoming().dateKey == existing().dateKey &&
                         incoming().inTime == existing().inTime &&
                         incoming().inConfidence == existing().inConfidence &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         (
                           // Action 1: Check-OUT once per day, only after Check-IN
                           (
                             existing().attendanceStatus == 'CHECKED_IN' &&
                             !('outTime' in existing()) &&
                             incoming().attendanceStatus == 'COMPLETED' &&
                             incoming().outTime is timestamp &&
                             incoming().outTime <= request.time &&
                             incoming().outTime >= existing().inTime &&
                             ('outConfidence' in incoming()) &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'outTime', 'outConfidence', 'faceVerificationStatus', 'attendanceStatus', 'updatedAt'
                             ])
                           ) ||
                           // Action 2: Star / favorite toggle without mutating attendance times or status
                           (
                             incoming().attendanceStatus == existing().attendanceStatus &&
                             (!('outTime' in existing()) ? !('outTime' in incoming()) : incoming().outTime == existing().outTime) &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['starred', 'updatedAt'])
                           )
                         );

        allow delete: if false;
      }

      match /attendance_logs/{logId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(logId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(logId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll([
                           'userId', 'userName', 'dateKey', 'actionType',
                           'faceVerificationStatus', 'attendanceStatus', 'reason', 'confidence', 'timestamp'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'userName', 'dateKey', 'actionType',
                           'faceVerificationStatus', 'attendanceStatus', 'reason', 'confidence', 'timestamp'
                         ]) &&
                         isValidVerificationLog(incoming()) &&
                         incoming().timestamp is timestamp &&
                         incoming().timestamp <= request.time;

        allow update, delete: if false;
      }
    }
  }
}
